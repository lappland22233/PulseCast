<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="po">
    <SolidColorBrush x:Key="AppBackground" Color="#191918" po:Freeze="True"/>
    <SolidColorBrush x:Key="Surface" Color="#211F1D" po:Freeze="True"/>
    <SolidColorBrush x:Key="Field" Color="#272522" po:Freeze="True"/>
    <SolidColorBrush x:Key="SurfaceHover" Color="#302D29" po:Freeze="True"/>
    <SolidColorBrush x:Key="SurfacePressed" Color="#39342F" po:Freeze="True"/>
    <SolidColorBrush x:Key="Separator" Color="#37342F" po:Freeze="True"/>
    <SolidColorBrush x:Key="ControlBorder" Color="#504A42" po:Freeze="True"/>
    <SolidColorBrush x:Key="SelectedSurface" Color="#3A2B25" po:Freeze="True"/>

    <SolidColorBrush x:Key="Accent" Color="#F18875" po:Freeze="True"/>
    <SolidColorBrush x:Key="AccentHover" Color="#FFA692" po:Freeze="True"/>
    <SolidColorBrush x:Key="AccentPressed" Color="#DE7968" po:Freeze="True"/>
    <SolidColorBrush x:Key="AccentInk" Color="#231512" po:Freeze="True"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#F1EEE8" po:Freeze="True"/>
    <SolidColorBrush x:Key="TextMuted" Color="#B9B1A3" po:Freeze="True"/>
    <SolidColorBrush x:Key="TextFaint" Color="#A49A8B" po:Freeze="True"/>
    <SolidColorBrush x:Key="Live" Color="#A6D0AE" po:Freeze="True"/>
    <SolidColorBrush x:Key="Info" Color="#C2BEAF" po:Freeze="True"/>
    <SolidColorBrush x:Key="Warn" Color="#E5B77C" po:Freeze="True"/>
    <SolidColorBrush x:Key="Error" Color="#F18875" po:Freeze="True"/>

    <SolidColorBrush x:Key="OverlayPanelBrush" Color="#F0211F1D" po:Freeze="True"/>
    <SolidColorBrush x:Key="OverlayBorderBrush" Color="#906B6156" po:Freeze="True"/>
</ResourceDictionary>
