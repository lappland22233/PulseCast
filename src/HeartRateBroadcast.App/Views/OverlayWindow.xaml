<Window x:Class="HeartRateBroadcast.App.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize" Topmost="True"
        SizeToContent="WidthAndHeight" Opacity="{Binding OverlayOpacity}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanVisibility"/>
    </Window.Resources>
    <Border x:Name="OverlayBackground" CornerRadius="6" BorderBrush="{StaticResource OverlayBorderBrush}" BorderThickness="1"
            Background="{StaticResource OverlayPanelBrush}" Padding="13,7" MouseLeftButtonDown="OnDrag">
        <Grid x:Name="RootGrid">
            <Grid.LayoutTransform>
                <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}"/>
            </Grid.LayoutTransform>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Viewbox Width="21" Height="21" VerticalAlignment="Center" Margin="0,0,9,0"
                     Visibility="{Binding ShowHeart, Converter={StaticResource BooleanVisibility}}">
                <Path x:Name="HeartIcon" Fill="{StaticResource Accent}"
                      Data="M12,21.35L10.55,20.03C5.4,15.36 2,12.27 2,8.5C2,5.41 4.42,3 7.5,3C9.24,3 10.91,3.81 12,5.08C13.09,3.81 14.76,3 16.5,3C19.58,3 22,5.41 22,8.5C22,12.27 18.6,15.36 13.45,20.03L12,21.35Z">
                    <Path.RenderTransform>
                        <ScaleTransform x:Name="HeartScale" CenterX="12" CenterY="12"/>
                    </Path.RenderTransform>
                </Path>
            </Viewbox>

            <TextBlock x:Name="BpmText" Grid.Column="1"
                       FontFamily="{Binding NumberFontFamily}" FontSize="{Binding NumberFontSize}"
                       FontWeight="Bold" VerticalAlignment="Center" Foreground="{StaticResource TextPrimary}"/>

            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="9,0,0,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding ShowUnit}" Value="False"/>
                                    <Condition Binding="{Binding ShowLive}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock x:Name="UnitText" Text="BPM" FontFamily="Consolas" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TextMuted}"
                           Visibility="{Binding ShowUnit, Converter={StaticResource BooleanVisibility}}"/>
                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding ShowLive, Converter={StaticResource BooleanVisibility}}">
                    <Ellipse x:Name="LiveDot" Width="5" Height="5" Fill="{StaticResource Live}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="LiveText" Text="{Binding Status}" FontSize="11"
                               Foreground="{StaticResource Live}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
