<Window x:Class="HeartRateBroadcast.App.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" Topmost="True"
        SizeToContent="WidthAndHeight" Opacity="{Binding OverlayOpacity}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Border x:Name="OverlayBackground" CornerRadius="18" BorderBrush="#50FFFFFF" BorderThickness="1"
            Background="#E6151821" Padding="18,12" MouseLeftButtonDown="OnDrag">
        <Grid x:Name="RootGrid">
            <Grid.LayoutTransform>
                <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}"/>
            </Grid.LayoutTransform>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Viewbox Width="28" Height="28" VerticalAlignment="Center"
                     Visibility="{Binding ShowHeart, Converter={StaticResource BoolToVis}}">
                <Path x:Name="HeartIcon" Fill="#FF4D6D"
                      Data="M12,21.35L10.55,20.03C5.4,15.36 2,12.27 2,8.5C2,5.41 4.42,3 7.5,3C9.24,3 10.91,3.81 12,5.08C13.09,3.81 14.76,3 16.5,3C19.58,3 22,5.41 22,8.5C22,12.27 18.6,15.36 13.45,20.03L12,21.35Z">
                    <Path.RenderTransform>
                        <ScaleTransform x:Name="HeartScale" CenterX="12" CenterY="12"/>
                    </Path.RenderTransform>
                </Path>
            </Viewbox>

            <TextBlock x:Name="BpmText" Grid.Column="1" Margin="12,0,0,0"
                       FontFamily="{Binding NumberFontFamily}" FontSize="{Binding NumberFontSize}"
                       FontWeight="Bold" VerticalAlignment="Center" Foreground="#F8FAFC"/>

            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0">
                <TextBlock x:Name="UnitText" Text="BPM" FontSize="11" FontWeight="SemiBold"
                           Foreground="#94A3B8"
                           Visibility="{Binding ShowUnit, Converter={StaticResource BoolToVis}}"/>
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0"
                            Visibility="{Binding ShowLive, Converter={StaticResource BoolToVis}}">
                    <Ellipse x:Name="LiveDot" Width="6" Height="6" Fill="#22C55E" VerticalAlignment="Center"/>
                    <TextBlock x:Name="LiveText" Text="{Binding Status}" FontSize="11"
                               Foreground="#22C55E" Margin="5,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
