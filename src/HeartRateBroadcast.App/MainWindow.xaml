<Window x:Class="HeartRateBroadcast.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="PulseCast" Width="1050" Height="720" MinWidth="780" MinHeight="520"
        WindowStartupLocation="CenterScreen" Style="{StaticResource AppWindow}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanVisibility"/>
        <Style x:Key="ColumnHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style x:Key="OverlayAction" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Padding" Value="5,5"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <DataTemplate x:Key="AppearanceSettings">
            <StackPanel Margin="0,6,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="自动反色" Style="{StaticResource SettingLabel}"/>
                        <ComboBox AutomationProperties.Name="自动反色" SelectedValue="{Binding Overlay.InversionMode, Mode=TwoWay}"
                                  ToolTip="隐藏背景时，自动按每个数字下方的明暗选色">
                            <sys:String>自动</sys:String>
                            <sys:String>强制浅字</sys:String>
                            <sys:String>强制深字</sys:String>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="数字字体" Style="{StaticResource SettingLabel}"/>
                        <ComboBox AutomationProperties.Name="数字字体" SelectedValue="{Binding Overlay.NumberFont, Mode=TwoWay}">
                            <sys:String>等宽</sys:String>
                            <sys:String>仪表</sys:String>
                            <sys:String>无衬线</sys:String>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <TextBlock Text="数字颜色" Style="{StaticResource SettingLabel}" Margin="0,13,0,5"/>
                <ComboBox AutomationProperties.Name="数字颜色" SelectedValue="{Binding Overlay.ColorMode, Mode=TwoWay}">
                    <sys:String>自动</sys:String>
                    <sys:String>逐字渐变</sys:String>
                    <sys:String>单色</sys:String>
                </ComboBox>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="渐变预设" Style="{StaticResource SettingLabel}"/>
                        <ComboBox AutomationProperties.Name="渐变预设" SelectedValue="{Binding Overlay.GradientId, Mode=TwoWay}">
                            <sys:String>红粉</sys:String>
                            <sys:String>冰蓝</sys:String>
                            <sys:String>翠绿</sys:String>
                            <sys:String>金橙</sys:String>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="单色预设" Style="{StaticResource SettingLabel}"/>
                        <ComboBox AutomationProperties.Name="单色预设" SelectedValue="{Binding Overlay.SolidColor, Mode=TwoWay}">
                            <sys:String>纯白</sys:String>
                            <sys:String>深黑</sys:String>
                            <sys:String>心率红</sys:String>
                            <sys:String>荧光绿</sys:String>
                            <sys:String>天蓝</sys:String>
                            <sys:String>琥珀</sys:String>
                            <sys:String>橙</sys:String>
                            <sys:String>玫红</sys:String>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <WrapPanel Margin="0,15,0,2">
                    <CheckBox Content="心形图标" IsChecked="{Binding Overlay.ShowHeart, Mode=TwoWay}" Margin="0,0,13,6"/>
                    <CheckBox Content="BPM 单位" IsChecked="{Binding Overlay.ShowUnit, Mode=TwoWay}" Margin="0,0,13,6"/>
                    <CheckBox Content="心率状态" IsChecked="{Binding Overlay.ShowLive, Mode=TwoWay}" Margin="0,0,0,6"/>
                </WrapPanel>

                <TextBlock Margin="0,8,0,0">
                    <Run Text="缩放"/><Run Text="  "/><Run Text="{Binding Overlay.Scale, Mode=OneWay, StringFormat={}{0:F2}×}" Foreground="{StaticResource TextMuted}"/>
                </TextBlock>
                <Slider AutomationProperties.Name="缩放" Minimum="0.75" Maximum="1.5" Value="{Binding Overlay.Scale, Mode=TwoWay}"
                        TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                <TextBlock Margin="0,8,0,0">
                    <Run Text="不透明度"/><Run Text="  "/><Run Text="{Binding Overlay.OverlayOpacity, Mode=OneWay, StringFormat={}{0:P0}}" Foreground="{StaticResource TextMuted}"/>
                </TextBlock>
                <Slider AutomationProperties.Name="不透明度" Minimum="0.5" Maximum="1" Value="{Binding Overlay.OverlayOpacity, Mode=TwoWay}"
                        TickFrequency="0.05" IsSnapToTickEnabled="True"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border BorderBrush="{StaticResource Separator}" BorderThickness="0,0,0,1">
            <DockPanel Margin="26,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{Binding ScanButtonText}" Command="{Binding ToggleScanCommand}" MinWidth="98"
                            AutomationProperties.HelpText="开始或停止扫描附近的蓝牙设备"/>
                    <Button Content="打开悬浮窗" Command="{Binding ShowOverlayCommand}" Style="{StaticResource PrimaryButton}"
                            MinWidth="108" Margin="9,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="35" Height="35" Background="{StaticResource SelectedSurface}" CornerRadius="5" Margin="0,0,11,0">
                        <Path Data="M1,11 L6,11 9,5 13,17 17,8 20,11 24,11" Stroke="{StaticResource Accent}"
                              StrokeThickness="1.6" StrokeLineJoin="Round" Stretch="Uniform" Width="24" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="心率广播" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.55*"/>
                <ColumnDefinition Width="*" MinWidth="322"/>
            </Grid.ColumnDefinitions>

            <Grid Margin="26,22,24,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="附近设备" Style="{StaticResource SectionHeading}"/>
                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <TextBox Style="{StaticResource SearchTextBox}" AutomationProperties.Name="搜索设备"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Escape" Command="{Binding ClearSearchCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <Path Data="M5,1 A4,4 0 1 1 5,9 A4,4 0 1 1 5,1 M8,8 L12,12" Stroke="{StaticResource TextMuted}"
                              StrokeThickness="1.2" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <TextBlock Text="搜索名称或地址" Foreground="{StaticResource TextFaint}" Margin="32,0,32,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSearchText}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Command="{Binding ClearSearchCommand}" ToolTip="清空搜索" AutomationProperties.Name="清空搜索"
                                Style="{StaticResource QuietButton}" MinHeight="24" Width="24" Padding="0"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0"
                                Visibility="{Binding HasSearchText, Converter={StaticResource BooleanVisibility}}">
                            <Path Data="M0,0 L7,7 M7,0 L0,7" Stroke="{StaticResource TextMuted}" StrokeThickness="1.4"/>
                        </Button>
                    </Grid>
                    <CheckBox Grid.Column="1" Content="隐藏匿名设备" IsChecked="{Binding HideUnknownDevices, Mode=TwoWay}"
                              VerticalAlignment="Center" Margin="13,0,0,0" Foreground="{StaticResource TextMuted}"/>
                </Grid>

                <Border Grid.Row="2" Margin="0,14,0,0" BorderBrush="{StaticResource Separator}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <Button Command="{Binding ShowHeartRateOnlyCommand}" Margin="0,0,19,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource DeviceTab}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FilterHeartRateOnly}" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock><Run Text="心率设备"/><Run Text="  "/><Run Text="{Binding HeartRateDeviceCount, Mode=OneWay}" Foreground="{StaticResource TextMuted}"/></TextBlock>
                        </Button>
                        <Button Command="{Binding ShowAllDevicesCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource DeviceTab}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FilterHeartRateOnly}" Value="False">
                                            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock><Run Text="全部设备"/><Run Text="  "/><Run Text="{Binding TotalDeviceCount, Mode=OneWay}" Foreground="{StaticResource TextMuted}"/></TextBlock>
                        </Button>
                    </StackPanel>
                </Border>

                <Border Grid.Row="3" Background="{StaticResource Surface}" BorderBrush="{StaticResource Separator}"
                        BorderThickness="0,0,0,1" Padding="10,0,20,0">
                    <Grid Height="30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="111"/>
                            <ColumnDefinition Width="76"/>
                            <ColumnDefinition Width="67"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="设备" Style="{StaticResource ColumnHeading}"/>
                        <TextBlock Grid.Column="1" Text="地址" Style="{StaticResource ColumnHeading}"/>
                        <TextBlock Grid.Column="2" Text="类型" Style="{StaticResource ColumnHeading}"/>
                        <TextBlock Grid.Column="3" Text="信号" Style="{StaticResource ColumnHeading}" HorizontalAlignment="Right"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="4">
                    <ListBox ItemsSource="{Binding FilteredDevices}" SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0" Padding="0" ItemContainerStyle="{StaticResource DeviceRow}"
                             ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Visible"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.CacheLength="0.5,0.5"
                             AutomationProperties.Name="附近的蓝牙设备">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="41" Margin="10,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="111"/>
                                        <ColumnDefinition Width="76"/>
                                        <ColumnDefinition Width="67"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" TextTrimming="CharacterEllipsis"
                                               Margin="0,0,10,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding AddressText}" FontFamily="Consolas" FontSize="12"
                                               VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding CategoryBadgeText}" FontSize="12" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Category}" Value="Broadcasting">
                                                        <Setter Property="Foreground" Value="{StaticResource Live}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Category}" Value="CandidateName">
                                                        <Setter Property="Foreground" Value="{StaticResource Warn}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Grid.Column="3" Text="{Binding Rssi, StringFormat={}{0} dBm}" FontFamily="Consolas"
                                               FontSize="12" Foreground="{StaticResource TextMuted}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="{Binding EmptyStateText}" Visibility="{Binding HasNoDevices, Converter={StaticResource BooleanVisibility}}"
                               AutomationProperties.LiveSetting="Polite" MaxWidth="280" Margin="14,0"
                               Foreground="{StaticResource TextMuted}" TextAlignment="Center" TextWrapping="Wrap"
                               VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>

                <Border Grid.Row="5" BorderBrush="{StaticResource Separator}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{Binding ConnectButtonText}" Command="{Binding ConnectSelectedDeviceCommand}"
                                MinWidth="113" ToolTip="支持心率广播的设备只需选中"/>
                        <Button Content="取消连接" Command="{Binding CancelConnectCommand}" Style="{StaticResource QuietButton}" Margin="4,0,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Column="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource Separator}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="24,22,24,20">
                        <TextBlock Text="实时心率" Style="{StaticResource SectionHeading}"/>
                        <TextBlock Text="{Binding SelectedDevice.Name, FallbackValue=未选择设备, TargetNullValue=未选择设备}"
                                   Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,8">
                            <TextBlock Text="{Binding CurrentBpm}" FontFamily="Consolas" FontSize="78" FontWeight="Normal"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="BPM" Foreground="{StaticResource Accent}" FontFamily="Consolas" FontSize="15"
                                       VerticalAlignment="Bottom" Margin="12,0,0,16"/>
                        </StackPanel>
                        <DockPanel Margin="0,0,0,20" LastChildFill="True">
                            <Ellipse DockPanel.Dock="Left" Width="6" Height="6" Fill="{Binding StatusBrush}"
                                     Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" TextWrapping="Wrap"
                                       AutomationProperties.LiveSetting="Polite"/>
                        </DockPanel>

                        <Border BorderBrush="{StaticResource Separator}" BorderThickness="0,1,0,1" Padding="0,18,0,14">
                            <StackPanel>
                                <TextBlock Text="悬浮窗" Style="{StaticResource SectionHeading}"/>
                                <UniformGrid Columns="3" Margin="0,11,0,0">
                                    <Button Content="{Binding OverlayLockButtonText}" Command="{Binding ToggleOverlayLockCommand}"
                                            Style="{StaticResource OverlayAction}" Margin="0,0,4,0"/>
                                    <Button Content="{Binding OverlayBackgroundButtonText}" Command="{Binding ToggleOverlayBackgroundCommand}"
                                            Style="{StaticResource OverlayAction}" Margin="2,0"/>
                                    <Button Content="{Binding OverlayClickThroughButtonText}" Command="{Binding ToggleOverlayClickThroughCommand}"
                                            Style="{StaticResource OverlayAction}" Margin="4,0,0,0"
                                            ToolTip="开启后，鼠标点击会穿过悬浮窗"/>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Expander Header="外观设置" Margin="0,7,0,0">
                            <Expander.Style>
                                <Style TargetType="Expander" BasedOn="{StaticResource AppearanceSection}">
                                    <Style.Triggers>
                                        <Trigger Property="IsExpanded" Value="True">
                                            <Setter Property="Content" Value="{Binding}"/>
                                            <Setter Property="ContentTemplate" Value="{StaticResource AppearanceSettings}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Expander.Style>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
